# Registers prebuilt mods (unpacked .dusk packages in prebuilt_mods/<id>) as bundled mods,
# exactly like add_mod(... BUNDLE) does for mods built from source. install_bundled_mods()
# then copies them into the app, puts lib/ios-arm64/mod.so in Frameworks/<id>.so and runs
# the iOS prepatch step over all of them.
if (NOT IOS)
    return()
endif ()
file(GLOB _prebuilt_dirs LIST_DIRECTORIES true "${CMAKE_SOURCE_DIR}/prebuilt_mods/*")
foreach (_dir IN LISTS _prebuilt_dirs)
    if (NOT IS_DIRECTORY "${_dir}")
        continue()
    endif ()
    file(READ "${_dir}/mod.json" _json)
    string(JSON _id GET "${_json}" id)
    set(_lib "${_dir}/lib/ios-arm64/mod.so")
    if (NOT EXISTS "${_lib}")
        message(FATAL_ERROR "Prebuilt mod ${_id} has no lib/ios-arm64/mod.so")
    endif ()
    string(MAKE_C_IDENTIFIER "prebuilt_${_id}" _tgt)
    add_library(${_tgt} SHARED IMPORTED GLOBAL)
    set_target_properties(${_tgt} PROPERTIES IMPORTED_LOCATION "${_lib}" IMPORTED_NO_SONAME TRUE)
    set_property(GLOBAL APPEND PROPERTY DUSK_BUNDLED_MOD_TARGETS "${_tgt}")
    set_property(GLOBAL APPEND PROPERTY DUSK_BUNDLED_MOD_IDS "${_id}")
    set_property(GLOBAL APPEND PROPERTY DUSK_BUNDLED_MOD_STAGES "${_dir}")
    set_property(GLOBAL APPEND PROPERTY DUSK_BUNDLED_MOD_PACKAGES "${_dir}")
    set_property(GLOBAL APPEND PROPERTY DUSK_BUNDLED_MOD_LIB_PLATFORMS "ios-arm64")
    set_property(GLOBAL APPEND PROPERTY DUSK_BUNDLED_MOD_LIB_NAMES "mod.so")
    message(STATUS "Bundling prebuilt mod ${_id}")
endforeach ()
